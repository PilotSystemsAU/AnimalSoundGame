# Required: the host's password for /admin
ADMIN_PASSWORD=

# Optional: change this to sign out every logged-in admin device
ADMIN_COOKIE_SECRET=

# Added automatically when you install Upstash Redis from the Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local development only: a plain Redis server instead of Upstash
REDIS_URL=redis://localhost:6379
